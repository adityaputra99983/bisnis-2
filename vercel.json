{
  "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput --clear",
  "framework": null,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@3",
      "maxDuration": 60,
      "includeFiles": [
        "dukun/**",
        "static/**",
        "staticfiles/**",
        "templates/**",
        "locale/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
