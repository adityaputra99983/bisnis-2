{
  "framework": "other",
  "buildCommand": "python manage.py collectstatic --noinput --clear",
  "outputDirectory": "staticfiles",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@3.0.0",
      "maxDuration": 60,
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
