{
  "buildCommand": "python manage.py collectstatic --noinput --clear",
  "outputDirectory": "staticfiles",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@3",
      "maxDuration": 60,
      "includeFiles": ["**"]
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
