{
  "buildCommand": "python manage.py collectstatic --noinput --clear",
  "outputDirectory": "staticfiles",
  "framework": null,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@3",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
