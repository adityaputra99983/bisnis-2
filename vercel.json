{
  "buildCommand": "cd dukun && pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate --noinput",
  "outputDirectory": "staticfiles",
  "framework": null,
  "functions": {
    "dukun/wsgi.py": {
      "runtime": "@vercel/python@3",
      "includeFiles": ["dukun/**", "static/**", "templates/**", "locale/**", "media/**"]
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dukun/wsgi.py"
    }
  ]
}
